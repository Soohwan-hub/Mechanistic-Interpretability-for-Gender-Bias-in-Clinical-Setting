{
  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex",
      "tools": ["pdflatex"]
    }
  ],
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux", "*.bbl", "*.blg", "*.idx", "*.ind", "*.lof",
    "*.lot", "*.out", "*.toc", "*.fls", "*.fdb_latexmk",
    "*.synctex.gz", "*.run.xml", "*.bcf"
  ],
  "files.exclude": {
    "paper/*.aux": true,
    "paper/*.bbl": true,
    "paper/*.blg": true,
    "paper/*.fdb_latexmk": true,
    "paper/*.fls": true,
    "paper/*.log": true,
    "paper/*.out": true,
    "paper/*.synctex.gz": true,
    "paper/*.toc": true
  }
}
